{
  "expo": {
    "name": "Lending",
    "slug": "lending-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "lending",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0b5fff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.frappe.lending"
    },
    "android": {
      "package": "com.frappe.lending"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "frappeSiteUrl": "https://dev-testcase.com"
    }
  }
}
